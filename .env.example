# Copy to .env and fill in your values:
#   cp .env.example .env

# ── Captcha ───────────────────────────────────────────────────────────────────
# Pick ONE API provider (onyx | nopecha | voidsolver | rezosolver | capless) by
# setting CAPTCHA_PROVIDER and filling that provider's key below — OR solve by
# hand:
#
#   CAPTCHA_PROVIDER=manual       # no API key needed. The bot opens a visible
#                                 # Chromium window with the hCaptcha widget and
#                                 # waits while YOU click the checkbox / solve
#                                 # the puzzle. The token is captured and used
#                                 # for the signup. It must be solved from the
#                                 # same IP the signup egresses from.
MEDAL_HCAPTCHA_SITEKEY=CHANGE_ME
EMAIL_DOMAIN=example.com

# API-provider keys (ignored when CAPTCHA_PROVIDER=manual):
ONYX_API_KEY=onyx_replace_me
NOPECHA_API_KEY=CHANGE_ME
VOIDSOLVER_API_KEY=CHANGE_ME
REZOSOLVER_API_KEY=CHANGE_ME
CAPLESS_API_KEY=CHANGE_ME

# ── Medal core ───────────────────────────────────────────────────────────────
ACCOUNTS_FILE=accounts.jsonl
FAILED_ACCOUNTS_FILE=failed-accounts.jsonl
PROXIES_FILE=proxies.txt
MEDAL_TIMEZONE=Asia/Jakarta

# One upstream IP per account: proxies already handed to an account are recorded
# in PROXY_USED_FILE and never reused. When the pool is exhausted the run stops
# unless PROXY_RESET=1 (clears the list so proxies can be recycled).
PROXY_USED_FILE=used_proxies.json
# PROXY_RESET=1

# ── DonutSMP Skeleton Spawner Quest ──────────────────────────────────────────
# The bot enrolls this quest after signup but NEVER claims the reward — you
# redeem it in-game as your connected Minecraft account on DonutSMP.
MEDAL_QUEST_ID=2pQLGqBjtd

# ── Java-cookie flow (medal_signup.js) ───────────────────────────────────────
# The Microsoft/Minecraft identities you want on DonutSMP are exported as
# Netscape-format .txt cookie files (one per Microsoft account) and dropped
# into JAVA_COOKIE_DIR, then run:
#   node medal_signup.js --java-cookie ./java_cookies
# Per account the bot: signup -> 5sim phone verify -> try the cookie files
# until one LINKS this Medal account (it opens a Chromium window seeded with
# that Microsoft session; approve it there if asked) -> enroll DonutSMP quest
# -> clip upload/post -> STOP. It never submits a quest claim; you redeem the
# reward in-game (/medal) as the linked Minecraft account.
JAVA_COOKIE_DIR=java_cookies
JAVA_COOKIE_DELAY_MS=3000
# Cookie exports that fail the Microsoft link are recorded here and skipped on
# re-runs (so a dead cookie never burns a second 5sim number).
JAVA_BAD_COOKIES_FILE=bad_java_cookies.jsonl
# Optional hard cap on how many new Medal accounts one run may create (0=until
# the cookie pool is exhausted).
# JAVA_MAX_ACCOUNTS=0
# Egress for the Microsoft-link Chromium window: 'direct' (default, matches the
# IP the exported cookies were minted on) or 'proxy' (use the account proxy).
# JAVA_LINK_PROXY=direct
# How long one link attempt may wait on Microsoft (consent/sign-in) in ms.
# JAVA_LINK_TIMEOUT_MS=240000

# ── Phone verification (5sim.net) ────────────────────────────────────────────
FIVESIM_API_KEY=fivesim_replace_me
FIVESIM_COUNTRY=england
FIVESIM_PRODUCT=medal
# Pick the operator dynamically from 5sim live prices (rank by availability,
# drop operators below FIVESIM_MIN_RATE) instead of only the static list.
FIVESIM_DYNAMIC_RANKING=1
FIVESIM_MIN_RATE=10

# ── Clip upload (MEDAL_CLIP_PATH must be a real file to run signups) ──────────
MEDAL_CLIP_PATH=/path/to/minecraft-clip.mp4
MEDAL_CLIP_DURATION=55
MEDAL_CLIP_TITLE=DonutSMP Minecraft Gameplay
MEDAL_CLIP_DESCRIPTION=#donutsmp
MEDAL_CLIP_TAGS=donutsmp,minecraft
# 0=PUBLIC (posts to profile - required for the DonutSMP quest), 1=UNLISTED, 2=PRIVATE
MEDAL_CLIP_PRIVACY=0
MEDAL_CLIP_CATEGORY_ID=hAXdelx2t

# ── Optional ───────────────────────────────────────────────────────────────────
# DISCORD_WEBHOOK_URL=
